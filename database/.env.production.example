# Set these on Render, not Vercel. Replace with the exact Supabase session URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL_MODE=verify-full
# Add the downloaded Supabase CA as a Render secret file with this filename.
DATABASE_SSL_CA_PATH=/etc/secrets/supabase-ca.crt
